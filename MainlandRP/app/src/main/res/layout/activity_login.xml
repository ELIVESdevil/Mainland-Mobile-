<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ImageView
        android:id="@+id/bgLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_login"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:weightSum="1000">

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="500">
            <View
                android:id="@+id/shimmerLogin"
                android:layout_width="140dp" android:layout_height="match_parent"
                android:background="@drawable/shimmer_gradient" android:rotation="20" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="450"
            android:orientation="horizontal" android:weightSum="1000">

            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="300" />

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="400">
                <View
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/shape_scrim_panel" />

                <ScrollView
                    android:layout_width="match_parent" android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:padding="14dp">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/login_title" android:textColor="@color/accent_gold"
                            android:textStyle="bold" android:textSize="15sp" android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="@string/hint_username" android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary" android:inputType="text" android:maxLength="24"
                            android:padding="9dp" android:background="@drawable/shape_input_gold" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:visibility="gone"
                            android:hint="Email Address" android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary" android:inputType="textEmailAddress"
                            android:padding="9dp" android:background="@drawable/shape_input_gold" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:hint="@string/hint_password" android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary" android:inputType="textPassword"
                            android:padding="9dp" android:background="@drawable/shape_input_gold" />

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:visibility="gone"
                            android:hint="Confirm Password" android:textColorHint="@color/text_secondary"
                            android:textColor="@color/text_primary" android:inputType="textPassword"
                            android:padding="9dp" android:background="@drawable/shape_input_gold" />

                        <Button
                            android:id="@+id/btnPrimary"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:text="@string/btn_login"
                            android:textColor="@color/bg_black" android:textStyle="bold"
                            android:background="@drawable/shape_button_gold" />

                        <TextView
                            android:id="@+id/tvToggleMode"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="@string/toggle_to_register"
                            android:textColor="@color/text_secondary" android:padding="4dp" />

                        <TextView
                            android:id="@+id/tvError"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/accent_red" android:gravity="center" android:visibility="gone" />

                    </LinearLayout>
                </ScrollView>
            </FrameLayout>

            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="300" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="50" />

    </LinearLayout>

</FrameLayout>
