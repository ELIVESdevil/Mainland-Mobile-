<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ImageView
        android:id="@+id/bgSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_splash"
        android:contentDescription="@null" />

    <!-- Shimmer sweep over the logo/title region -->
    <View
        android:id="@+id/shimmerSplash"
        android:layout_width="140dp"
        android:layout_height="0dp"
        android:background="@drawable/shimmer_gradient"
        android:rotation="20"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideProgressTop"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideProgressTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.857" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideProgressBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.883" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideProgressLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.353" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideProgressRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.648" />

    <!-- Real animated fill, drawn over the baked-in bar outline -->
    <View
        android:id="@+id/progressTrack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guideProgressTop"
        app:layout_constraintBottom_toBottomOf="@id/guideProgressBottom"
        app:layout_constraintStart_toStartOf="@id/guideProgressLeft"
        app:layout_constraintEnd_toEndOf="@id/guideProgressRight" />

    <View
        android:id="@+id/progressFill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shape_progress_fill"
        app:layout_constraintTop_toTopOf="@id/progressTrack"
        app:layout_constraintBottom_toBottomOf="@id/progressTrack"
        app:layout_constraintStart_toStartOf="@id/progressTrack" />

</androidx.constraintlayout.widget.ConstraintLayout>
