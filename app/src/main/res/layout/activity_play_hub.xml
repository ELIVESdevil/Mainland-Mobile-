<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ImageView
        android:id="@+id/bgPlayHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="300dp" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp" android:padding="16dp"
        android:orientation="vertical" android:gravity="center"
        android:background="@drawable/shape_scrim_panel">

        <TextView
            android:id="@+id/tvCharName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/accent_gold" android:textStyle="bold" android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPermissionStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/hud_permission_needed"
            android:textColor="@color/text_secondary" android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/hud_grant_permission"
            android:textColor="@color/bg_black" android:background="@drawable/shape_input_gold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/hud_launch_game"
            android:textColor="@color/bg_black" android:textStyle="bold"
            android:background="@drawable/shape_button_gold" />

    </LinearLayout>

</FrameLayout>
