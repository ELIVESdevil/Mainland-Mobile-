<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ImageView
        android:id="@+id/bgPlayHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_splash"
        android:contentDescription="@null" />

    <View
        android:id="@+id/hubPanel"
        android:layout_width="300dp" android:layout_height="wrap_content"
        android:background="@drawable/shape_scrim_panel"
        app:layout_constraintBottom_toBottomOf="parent" android:layout_marginBottom="28dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="16dp"
        app:layout_constraintTop_toTopOf="@id/hubPanel" app:layout_constraintBottom_toBottomOf="@id/hubPanel"
        app:layout_constraintStart_toStartOf="@id/hubPanel" app:layout_constraintEnd_toEndOf="@id/hubPanel">

        <TextView
            android:id="@+id/tvCharName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/accent_gold" android:textStyle="bold" android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPermissionStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/hud_permission_needed"
            android:textColor="@color/text_secondary" android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/hud_grant_permission"
            android:textColor="@color/bg_black" android:background="@drawable/shape_input_gold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLaunch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/hud_launch_game"
            android:textColor="@color/bg_black" android:textStyle="bold"
            android:background="@drawable/shape_button_gold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
