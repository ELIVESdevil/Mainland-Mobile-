<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ImageView
        android:id="@+id/bgLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_login"
        android:contentDescription="@null" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gPanelTop" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.50" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gPanelBottom" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.95" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gPanelLeft" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.30" />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gPanelRight" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.70" />

    <!-- Shimmer sweep over the logo, above the panel -->
    <View
        android:id="@+id/shimmerLogin"
        android:layout_width="140dp"
        android:layout_height="0dp"
        android:background="@drawable/shimmer_gradient"
        android:rotation="20"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/gPanelTop"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scrim: covers the artwork's baked-in fields/button so nothing doubles up with the real ones below -->
    <View
        android:id="@+id/loginScrim"
        android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/shape_scrim_panel"
        app:layout_constraintTop_toTopOf="@id/gPanelTop"
        app:layout_constraintBottom_toBottomOf="@id/gPanelBottom"
        app:layout_constraintStart_toStartOf="@id/gPanelLeft"
        app:layout_constraintEnd_toEndOf="@id/gPanelRight" />

    <ScrollView
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/loginScrim"
        app:layout_constraintBottom_toBottomOf="@id/loginScrim"
        app:layout_constraintStart_toStartOf="@id/loginScrim"
        app:layout_constraintEnd_toEndOf="@id/loginScrim">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="14dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/login_title" android:textColor="@color/accent_gold"
                android:textStyle="bold" android:textSize="15sp" android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/hint_username" android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary" android:inputType="text" android:maxLength="24"
                android:padding="9dp" android:background="@drawable/shape_input_gold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:visibility="gone"
                android:hint="Email Address" android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary" android:inputType="textEmailAddress"
                android:padding="9dp" android:background="@drawable/shape_input_gold" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_password" android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary" android:inputType="textPassword"
                android:padding="9dp" android:background="@drawable/shape_input_gold" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:visibility="gone"
                android:hint="Confirm Password" android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary" android:inputType="textPassword"
                android:padding="9dp" android:background="@drawable/shape_input_gold" />

            <Button
                android:id="@+id/btnPrimary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/btn_login"
                android:textColor="@color/bg_black" android:textStyle="bold"
                android:background="@drawable/shape_button_gold" />

            <TextView
                android:id="@+id/tvToggleMode"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/toggle_to_register"
                android:textColor="@color/text_secondary" android:padding="4dp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/accent_red" android:gravity="center" android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
